#!/bin/sh /etc/rc.common
USE_PROCD=1
START=18
STOP=10

start_service() {
	[ "$(uci -q get tr3000-switch.main.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/tr3000-switch daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 35
	procd_close_instance
}

reload_service() { stop; start; }
service_triggers() { procd_add_reload_trigger tr3000-switch; }

# Stopping the listener does not execute arbitrary user actions.
# Use `tr3000-switch run off` after stopping if that is the desired cleanup.
